---
interface Props {
  items: string[];
  label?: string;
}
const { items, label = 'Tech stack' } = Astro.props;
---

<ul class="flex flex-wrap gap-1.5" aria-label={label}>
  {
    items.map((item) => (
      <li class="rounded border border-line px-2 py-0.5 font-mono text-[0.7rem] text-muted">{item}</li>
    ))
  }
</ul>
