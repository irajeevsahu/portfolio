---
import { profile } from '../data/profile';
const year = new Date().getFullYear();
---

<footer class="mx-auto mt-24 w-full max-w-3xl px-5 pb-12 sm:px-6">
  <div class="flex flex-col gap-2 border-t border-line pt-6 font-mono text-xs text-muted sm:flex-row sm:justify-between">
    <p>© {year} {profile.name}</p>
    <p>
      Built with Astro ·
      <a href={`${profile.links.github}/portfolio`} class="underline-offset-4 hover:text-fg hover:underline">source</a>
    </p>
  </div>
</footer>
