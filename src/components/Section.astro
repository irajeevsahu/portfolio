---
interface Props {
  id: string;
  index: string;
  title: string;
  intro?: string;
}
const { id, index, title, intro } = Astro.props;
---

<section id={id} class="pt-20 sm:pt-24" aria-labelledby={`${id}-title`}>
  <p class="font-mono text-xs uppercase tracking-widest text-accent">{index}</p>
  <h2 id={`${id}-title`} class="mt-2 text-2xl font-semibold tracking-tight sm:text-3xl">{title}</h2>
  {intro && <p class="mt-3 max-w-2xl text-muted">{intro}</p>}
  <div class="mt-10">
    <slot />
  </div>
</section>
