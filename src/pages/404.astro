---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---

<Base title="Page not found — Rajeev Sahu">
  <section class="py-32">
    <p class="font-mono text-sm text-accent">404</p>
    <h1 class="mt-2 text-3xl font-semibold tracking-tight">This page doesn’t exist.</h1>
    <a href="/" class="mt-8 inline-flex items-center gap-1.5 text-muted hover:text-fg">
      <Icon name="arrow-left" /> Back home
    </a>
  </section>
</Base>
